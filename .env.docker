APP_NAME=ElderApp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
STATIC_HOST=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=elderapp
DB_USERNAME=elderapp
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DRIVER=local

# FTP for CKEditor content images (eventContent / productContent)
# If not set, image uploads in the admin panel will fail
FILE_SEVER_HOST=
FILE_SEVER_USERNAME=
FILE_SEVER_PASSWORD=

JWT_SECRET=

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
